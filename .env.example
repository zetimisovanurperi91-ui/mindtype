# Get this from @BotFather on Telegram
BOT_TOKEN=123456789:AAAA-your-bot-token-here

# Matches the postgres service in docker-compose.yml by default.
# If you're running Postgres yourself instead, point this at it.
DATABASE_URL=postgresql+asyncpg://mindtype:mindtype@localhost:5432/mindtype

# Your numeric Telegram user ID (get it from @userinfobot). Comma-separate
# for multiple admins, e.g. ADMIN_IDS=111111111,222222222
ADMIN_IDS=123456789
